FROM node:22-alpine AS builder

ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

WORKDIR /app
COPY dashboard-next/package.json dashboard-next/package-lock.json ./
RUN npm ci
COPY dashboard-next/ .
RUN npm run build

# ─── Production image ──────────────────────────────────────────
FROM node:22-alpine AS runner

RUN addgroup -g 1001 -S career && \
    adduser -S career -u 1001

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --from=builder --chown=career:career /app/.next/standalone ./
COPY --from=builder --chown=career:career /app/.next/static ./.next/static
COPY --from=builder --chown=career:career /app/public ./public
COPY --from=builder --chown=career:career /app/node_modules ./node_modules
COPY --from=builder --chown=career:career /app/package.json ./

USER career

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://localhost:3000').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
