FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
    python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright

COPY package.json package-lock.json* ./
RUN npm install --omit=dev

COPY lib/ ./lib/
COPY config/ ./config/
COPY templates/ ./templates/
COPY modes/ ./modes/
COPY resumes/ ./resumes/
COPY scripts/ ./scripts/
COPY *.mjs ./
COPY *.md ./
COPY VERSION ./
COPY ecosystem.config.cjs ./

RUN mkdir -p data reports output interview-prep jds logs

ENV NODE_ENV=production
ENV DAEMON_PORT=4173
ENV PIPELINE_INTERVAL=3600
ENV SCAN_INTERVAL=180
ENV MAX_APPLY_PER_RUN=10
ENV MIN_SCORE=3.5
ENV PIPELINE_WORKERS=3
EXPOSE 4173

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://localhost:4173/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "daemon.mjs"]
