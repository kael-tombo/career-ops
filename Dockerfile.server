FROM node:22-alpine AS builder

RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# ─── Production image ──────────────────────────────────────────
FROM node:22-alpine AS runner

RUN addgroup -g 1001 -S career && \
    adduser -S career -u 1001

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY package.json ./
COPY lib/ ./lib/
COPY config/ ./config/
COPY templates/ ./templates/
COPY fonts/ ./fonts/
COPY modes/ ./modes/
COPY *.mjs ./
COPY *.md ./
COPY VERSION ./

RUN mkdir -p data reports output interview-prep jds && \
    chown -R career:career /app

USER career

ENV PORT=3001
ENV HOST=0.0.0.0
ENV NODE_ENV=production
ENV LOG_LEVEL=info
EXPOSE 3001

VOLUME [ "/app/data", "/app/reports", "/app/output", "/app/interview-prep", "/app/jds" ]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3001/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "server.mjs"]
