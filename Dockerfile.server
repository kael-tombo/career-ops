FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
    python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright

COPY package.json package-lock.json* ./
RUN npm install --omit=dev && npx playwright install chromium --with-deps 2>/dev/null || true

COPY lib/ ./lib/
COPY config/ ./config/
COPY templates/ ./templates/
COPY modes/ ./modes/
COPY resumes/ ./resumes/
COPY scripts/ ./scripts/
COPY *.mjs ./
COPY *.md ./
COPY VERSION ./
COPY ecosystem.config.cjs ./

RUN mkdir -p data reports output interview-prep jds logs

ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0
ENV LOG_LEVEL=info
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://localhost:3001/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "server.mjs"]
