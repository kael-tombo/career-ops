    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.18.1",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.0.0",
    "fastify": "^5.10.0",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.1",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
